# Variables del frontend (se leen al compilar con `npm run build`).
# Copia este archivo a .env solo si necesitas cambiar algo.

# URL del backend.
# - Un solo servicio en Render (el backend sirve el frontend): déjala SIN definir.
# - Frontend y backend en servicios separados: pon la URL del backend, sin barra final.
# - Desarrollo local: no hace falta, se usa http://localhost:5000
# VITE_API_URL=https://tu-backend.onrender.com
