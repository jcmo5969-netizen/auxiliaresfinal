# Variables de entorno - NO subir .env a GitHub (contiene secretos).
# En Render: configurar estas variables en el Dashboard (Environment).
# En local: copiar este archivo a .env y rellenar los valores.
#   cp .env.example .env   (o en Windows: copy .env.example .env)

JWT_SECRET=tu_clave_secreta_minimo_32_caracteres_aqui
JWT_EXPIRE=7d

# Base de datos (PostgreSQL)
# En Render suele usarse DATABASE_URL; en local, las variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_auxiliares
DB_USER=postgres
DB_PASSWORD=

# Opcional: una sola URL (Render suele dar DATABASE_URL)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Cliente (CORS). En Render: URL del frontend (ej. https://tu-app.onrender.com)
CLIENT_URL=http://localhost:5173

# Puerto (Render asigna PORT automáticamente)
PORT=5000
