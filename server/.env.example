# Variables de entorno del servidor.
# Local:  copia este archivo a .env y completa los valores (el .env nunca se sube a Git).
# Render: configúralas en el panel del servicio (Environment).

# ── Obligatorias ─────────────────────────────────────────────────────────────
# Clave para firmar las sesiones. Usa un texto largo y aleatorio (32+ caracteres).
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
JWT_EXPIRE=7d

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Opción A (Render): una sola URL. Dentro de Render usa la "Internal Database URL".
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
#
# CUIDADO: si pones aquí la URL de la base de PRODUCCIÓN, al ejecutar el servidor en tu
# computador estarás trabajando sobre los datos reales del hospital.
#
# Opción B (local): variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_auxiliares
DB_USER=postgres
DB_PASSWORD=

# SSL de la base: normalmente se detecta solo. Fuerza con true / false si hace falta.
# DATABASE_SSL=true

# Solo para desarrollo: permite que Sequelize modifique tablas existentes al arrancar.
# Nunca lo actives contra la base de producción.
# DB_SYNC_ALTER=true

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=5000
# URL(s) del frontend, separadas por coma. Se usa para CORS y para el código QR.
# Si el backend también sirve el frontend (un solo servicio en Render) no es necesaria.
CLIENT_URL=http://localhost:5173

# ── Administrador inicial (solo se usa si aún no existe ninguno) ─────────────
# ADMIN_EMAIL=admin@hospital.cl
# ADMIN_PASSWORD=una_clave_segura

# ── Notificaciones push (opcional) ───────────────────────────────────────────
# No hace falta configurar nada: las claves se generan solas y se guardan en la base.
# Defínelas solo si quieres conservar las mismas claves al cambiar de base de datos
# (si cambian, cada persona debe volver a tocar "Activar notificaciones").
# Genera un par con:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto que exige el estándar (mailto: o https://). Por defecto se usa CLIENT_URL.
# VAPID_SUBJECT=mailto:informatica@hospital.cl

# ── Mantenimiento (opcional) ─────────────────────────────────────────────────
# Habilita POST /api/reconnect (cabecera x-reconnect-key) para reiniciar el pool de la BD.
# RECONNECT_KEY=
# Muestra el detalle de errores internos en las respuestas (solo para depurar).
# EXPOSE_API_ERRORS=true
